{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Audio Cut",
  "version": "0.1.2",
  "identifier": "io.github.xander_lin.simple_audio_cut",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Simple Audio Cut",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
